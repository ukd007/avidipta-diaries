<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>News Layout</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container py-5">

  <!-- Headline News -->
  <div class="row mb-4">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Main Headline News</h5>
          <p class="card-text">This is a short summary of the main headline news. It grabs attention and is placed prominently.</p>
          <a href="#" class="btn btn-primary">Read More</a>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="list-group">
        <a href="#" class="list-group-item list-group-item-action active" aria-current="true">
          Latest Headlines
        </a>
        <a href="#" class="list-group-item list-group-item-action">Breaking: New Policy Announced</a>
        <a href="#" class="list-group-item list-group-item-action">Sports Update: Team Wins Trophy</a>
        <a href="#" class="list-group-item list-group-item-action">Tech: New Gadget Released</a>
      </div>
    </div>
  </div>

  <!-- News Articles -->
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">News Title 1</h5>
          <p class="card-text">Brief description of the news story. It gives a teaser about the article.</p>
          <a href="#" class="btn btn-sm btn-outline-primary">Read More</a>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">News Title 2</h5>
          <p class="card-text">Brief description of the news story. It gives a teaser about the article.</p>
          <a href="#" class="btn btn-sm btn-outline-primary">Read More</a>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">News Title 3</h5>
          <p class="card-text">Brief description of the news story. It gives a teaser about the article.</p>
          <a href="#" class="btn btn-sm btn-outline-primary">Read More</a>
        </div>
      </div>
    </div>
  </div>

</div>
</body>
</html>
