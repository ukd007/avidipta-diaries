<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>News Layout</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles/users/cricket.css">
</head>

<body>
  <div class="container mt-3">
    <% if (user.role==='admin' ) { %>
      <a href="/admin/dashboard" class="btn btn-outline-dark mb-3">
        ← Back to Dashboard
      </a>
      <% } else { %>
        <a href="/users/home" class="btn btn-outline-dark mb-3">
          ← Back to Home
        </a>
        <% } %>
  </div>



  <div class="container py-5">

    <!-- 🔧 Admin: Add News Form -->
    <% if (isAdmin) { %>
      <form method="POST" action="/admin/news/new" class="mb-5 p-3 border rounded">
        <h4>Add News</h4>
        <input name="title" class="form-control mb-2" placeholder="Title" required>
        <textarea name="content" class="form-control mb-2" placeholder="Content" required></textarea>
        <select name="type" class="form-select mb-2">
          <option value="headline">Headline</option>
          <option value="article" selected>Article</option>
        </select>
        <button class="btn btn-success btn-sm">➕ Add</button>
      </form>
      <% } %>

        <!-- Headline News -->
        <div class="row mb-4">
          <div class="col-lg-8">
            <% newsItems.filter(n=> n.type === 'headline').forEach(item => { %>
              <div class="card mb-3">
                <div class="card-body">
                  <% if (isAdmin && String(editingId)===String(item.id)) { %>
                    <!-- ✏️ Edit Headline -->
                    <form method="POST" action="/admin/news/<%= item.id %>/edit">
                      <input name="title" class="form-control mb-2" value="<%= item.title %>" required>
                      <textarea name="content" class="form-control mb-2"><%= item.content %></textarea>
                      <input type="hidden" name="type" value="headline">
                      <button class="btn btn-success btn-sm">💾 Save</button>
                      <a href="/news" class="btn btn-secondary btn-sm">Cancel</a>
                    </form>
                    <% } else { %>
                      <h5 class="card-title">
                        <%= item.title %>
                      </h5>
                      <p class="card-text">
                        <%= item.content %>
                      </p>
                      <% if (isAdmin) { %>
                        <a href="/news?edit=<%= item.id %>" class="btn btn-sm btn-primary">✏️ Edit</a>
                        <form method="POST" action="/admin/news/<%= item.id %>/delete" class="d-inline">
                          <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this news?')">🗑️
                            Delete</button>
                        </form>
                        <% } else { %>
                          <a href="#" class="btn btn-primary">Read More</a>
                          <% } %>
                            <% } %>
                </div>
              </div>
              <% }) %>
          </div>

          <div class="col-lg-4">
            <div class="list-group">
              <a href="#" class="list-group-item list-group-item-action active" aria-current="true">
                Latest Headlines
              </a>
              <% newsItems.filter(n=> n.type === 'headline').forEach(item => { %>
                <a href="#" class="list-group-item list-group-item-action">
                  <%= item.title %>
                </a>
                <% }) %>
            </div>
          </div>
        </div>

        <!-- Articles Section -->
        <div class="row">
          <% newsItems.filter(n=> n.type === 'article').forEach(item => { %>
            <div class="col-md-4 mb-4">
              <div class="card h-100">
                <div class="card-body">
                  <% if (isAdmin && String(editingId)===String(item.id)) { %>
                    <form method="POST" action="/admin/news/<%= item.id %>/edit">
                      <input name="title" class="form-control mb-2" value="<%= item.title %>" required>
                      <textarea name="content" class="form-control mb-2"><%= item.content %></textarea>
                      <input type="hidden" name="type" value="article">
                      <button class="btn btn-success btn-sm">💾 Save</button>
                      <a href="/news" class="btn btn-secondary btn-sm">Cancel</a>
                    </form>
                    <% } else { %>
                      <h5 class="card-title">
                        <%= item.title %>
                      </h5>
                      <p class="card-text">
                        <%= item.content %>
                      </p>
                      <% if (isAdmin) { %>
                        <a href="/news?edit=<%= item.id %>" class="btn btn-sm btn-primary">✏️ Edit</a>
                        <form method="POST" action="/admin/news/<%= item.id %>/delete" class="d-inline">
                          <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this article?')">🗑️
                            Delete</button>
                        </form>
                        <% } else { %>
                          <a href="#" class="btn btn-sm btn-outline-primary">Read More</a>
                          <% } %>
                            <% } %>
                </div>
              </div>
            </div>
            <% }) %>
        </div>

        <!-- Footer -->
        <footer class="bg-dark text-white text-center py-3 mt-5">
          <div class="container">
            <p class="mb-1">&copy; ACA 2025. All rights reserved.</p>
            <p class="mb-0">Designed and developed by <strong>Swapnesh,Tuntai,Papai</strong></p>
            <p class="mb-0">Speecial Thanks To <strong>Aritra</strong></p>
          </div>
        </footer>

  </div>
</body>

</html>