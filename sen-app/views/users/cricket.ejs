<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>News Layout</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles/users/cricket.css">
</head>
<body>
<a href="javascript:history.back()" class="btn btn-outline-secondary mb-3">&larr; Back</a>

<div class="container py-5">

  <!-- Headline News -->
  <div class="row mb-4">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Record !!</h5>
          <p class="card-text">Swapnesh & Ishan patnership scores record making patnership of 170 runs(174b) .</p>
          <a href="#" class="btn btn-primary">Read More</a>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="list-group">
        <a href="#" class="list-group-item list-group-item-action active" aria-current="true">
          Latest Headlines
        </a>
        <a href="#" class="list-group-item list-group-item-action">Breaking: Bibiswan anounced retirement from test cricket</a>
        <a href="#" class="list-group-item list-group-item-action">Sports Update: Team Angshu Wins a match
        </a>
        <a href="#" class="list-group-item list-group-item-action">Dispute : A new rivalry unlocks between Bibaswan and Shashwat</a>
      </div>
    </div>
  </div>

  <!-- News Articles -->
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Team Papai v/s Team Rudraksh</h5>
          <p class="card-text">Team Rudraksh win by </p>
          <a href="#" class="btn btn-sm btn-outline-primary">Read More</a>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">News Title 2</h5>
          <p class="card-text">Brief description of the news story. It gives a teaser about the article.</p>
          <a href="#" class="btn btn-sm btn-outline-primary">Read More</a>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">News Title 3</h5>
          <p class="card-text">Brief description of the news story. It gives a teaser about the article.</p>
          <a href="#" class="btn btn-sm btn-outline-primary">Read More</a>
        </div>
      </div>
    </div>
  </div>

</div>
</body>
</html>
