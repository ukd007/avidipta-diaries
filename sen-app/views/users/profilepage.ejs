<!DOCTYPE html>
<html>

<head>
  <title>Cricket Stats</title>
</head>

<body>
  <h1>Profiles</h1>
  <table>
    <tr>
      <th>Name</th>
      <th>DP</th>
      <th>Bio</th>
    </tr>
    <% players.forEach(player=> { %>
      <tr>
        <td>
          <%= player.names %>
        </td>
        <td></td>
        <td></td>
      </tr>
      <% }); %>


  </table>


</body>

</html>