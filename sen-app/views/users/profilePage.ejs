<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title><%= user.username %>'s Profile</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/styles/users/profilePage.css" rel="stylesheet" />
</head>

<body class="bg-light">
  <div class="container py-4">
    <!-- Back Button -->
    <a href="javascript:history.back()" class="btn btn-outline-secondary mb-3">&larr; Back</a>

    <!-- Profile Header -->
    <div class="d-flex align-items-center gap-3 mb-4">
      <img src="<%= user.profile_pic %>" alt="Profile Picture" class="profile-pic" />
      <div class="username fs-3 fw-semibold"><%= user.username %></div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs justify-content-center" id="profileTabs" role="tablist">
      <% const tests = { s25: 'Summer 2025', w24: 'Winter 2024', s24: 'Summer 2024' }; %>
      <% Object.keys(tests).forEach((test, i) => { %>
        <li class="nav-item" role="presentation">
          <button
            class="nav-link <%= i === 0 ? 'active' : '' %>"
            id="<%= test %>-tab"
            data-bs-toggle="tab"
            data-bs-target="#<%= test %>"
            type="button"
            role="tab"
            aria-controls="<%= test %>"
            aria-selected="<%= i === 0 %>"
          >
            <%= tests[test] %>
          </button>
        </li>
      <% }) %>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="profileTabsContent">
      <% Object.keys(tests).forEach((test, i) => {
        const batStats = stats[test].bat;
        const bowlStats = stats[test].bowl;
        const fieldStats = stats[test].field;

        const ballsBowled = bowlStats.total_balls_bowled || 0;
        const oversDisplay = Math.floor(ballsBowled / 6) + "." + (ballsBowled % 6);
      %>
        <div
          class="tab-pane fade <%= i === 0 ? 'show active' : '' %>"
          id="<%= test %>"
          role="tabpanel"
          aria-labelledby="<%= test %>-tab"
          tabindex="0"
        >
          <h4 class="mt-4 mb-3"><%= tests[test] %> Stats</h4>

          <!-- Batting -->
          <h5>Batting</h5>
          <table class="table table-bordered table-striped">
            <thead class="table-dark">
              <tr>
                <th>Runs Scored</th>
                <th>Wickets Played</th>
                <th>Batting Average</th>
                <th>Strike Rate</th>
                <th>4s Hit</th>
                <th>50s</th>
                <th>100s</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><input class="form-control" value="<%= batStats.runs %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= batStats.wickets_played %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= (batStats.wickets_played ? (batStats.runs / batStats.wickets_played).toFixed(2) : '0.00') %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= (batStats.balls_played ? ((batStats.runs * 100) / batStats.balls_played).toFixed(2) : '0.00') %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= batStats.fours %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= batStats.fifties %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= batStats.hundreds %>" readonly disabled /></td>
              </tr>
            </tbody>
          </table>

          <!-- Bowling -->
          <h5>Bowling</h5>
          <table class="table table-bordered table-striped">
            <thead class="table-dark">
              <tr>
                <th>Wickets Taken</th>
                <th>Overs Bowled</th>
                <th>Maidens</th>
                <th>Economy</th>
                <th>Strike Rate</th>
                <th>Bowling Average</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><input class="form-control" value="<%= bowlStats.wickets_taken %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= oversDisplay %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= bowlStats.maidens %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= (ballsBowled ? (bowlStats.runs_conceded / (ballsBowled / 6)).toFixed(2) : '0.00') %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= (bowlStats.wickets_taken ? (ballsBowled / bowlStats.wickets_taken).toFixed(2) : '0.00') %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= (bowlStats.wickets_taken ? (bowlStats.runs_conceded / bowlStats.wickets_taken).toFixed(2) : '0.00') %>" readonly disabled /></td>
              </tr>
            </tbody>
          </table>

          <!-- Fielding -->
          <h5>Fielding</h5>
          <table class="table table-bordered table-striped">
            <thead class="table-dark">
              <tr>
                <th>Catches</th>
                <th>Runouts</th>
                <th>Stumpings</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><input class="form-control" value="<%= fieldStats.catches %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= fieldStats.runouts %>" readonly disabled /></td>
                <td><input class="form-control" value="<%= fieldStats.stumpings %>" readonly disabled /></td>
              </tr>
            </tbody>
          </table>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Bootstrap JS Bundle (Popper + Bootstrap) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
