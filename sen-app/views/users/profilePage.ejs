<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title><%= user.username %>'s Profile</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/styles/users/profilePage.css" rel="stylesheet">
</head>

<body class="bg-light">
  <div class="container py-4">
    <a href="javascript:history.back()" class="btn btn-outline-secondary mb-3">
      &larr; Back
    </a>

    <!-- Profile Header -->
    <div class="d-flex align-items-center gap-3 mb-4">
      <img src="<%= user.profile_pic %>" alt="Profile Picture" class="profile-pic">
      <div class="username">
        <%= user.username %>
      </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs justify-content-center" id="profileTabs" role="tablist">
      <% const tests = ['summer25', 'winter24', 'summer24']; %>
      <% tests.forEach((test, i) => { %>
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= i === 0 ? 'active' : '' %>" id="<%= test %>-tab" data-bs-toggle="tab" data-bs-target="#<%= test %>" type="button" role="tab">
            <%= test.charAt(0).toUpperCase() + test.slice(1) %> Test
          </button>
        </li>
      <% }) %>
    </ul>

    <!-- Convert overs to balls function -->
    <% function convertOversToBalls(overs) {
      const [whole, fraction] = overs.split('.').map(Number);
      return (whole * 6) + (fraction || 0);
    } %>

    <!-- Tab Content -->
    <div class="tab-content" id="profileTabsContent">
      <% tests.forEach((test, i) => {
        const batStats = stats[test].bat;
        const bowlStats = stats[test].bowl;
        const fieldStats = stats[test].field;
        const ballsBowled = convertOversToBalls(bowlStats.overs_bowled);
      %>
        <div class="tab-pane fade <%= i === 0 ? 'show active' : '' %>" id="<%= test %>" role="tabpanel">
          <!-- Batting Table -->
          <h5 class="mt-4">Batting</h5>
          <table class="table table-bordered table-striped">
            <thead class="table-dark">
              <tr>
                <th>Runs Scored</th>
                <th>Wickets Played</th>
                <th>Batting Average</th>
                <th>Average Strike Rate</th>
                <th>4s Hit</th>
                <th>50s</th>
                <th>100s</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><%= batStats.runs %></td>
                <td><%= batStats.wickets_played %></td>
                <td><%= (batStats.runs / batStats.wickets_played).toFixed(2) %></td>
                <td><%= ((batStats.runs * 100) / batStats.balls_played).toFixed(2) %></td>
                <td><%= batStats.fours %></td>
                <td><%= batStats.fifties %></td>
                <td><%= batStats.hundreds %></td>
              </tr>
            </tbody>
          </table>

          <!-- Bowling Table -->
          <h5>Bowling</h5>
          <table class="table table-bordered table-striped">
            <thead class="table-dark">
              <tr>
                <th>Wickets Taken</th>
                <th>Overs Bowled</th>
                <th>Maidens</th>
                <th>Average Economy</th>
                <th>Strike Rate</th>
                <th>Bowling Average</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><%= bowlStats.wickets_taken %></td>
                <td><%= bowlStats.overs_bowled %></td>
                <td><%= bowlStats.maidens %></td>
                <td><%= (bowlStats.runs_conceded / (ballsBowled / 6)).toFixed(2) %></td>
                <td><%= (ballsBowled / bowlStats.wickets_taken).toFixed(2) %></td>
                <td><%= (bowlStats.runs_conceded / bowlStats.wickets_taken).toFixed(2) %></td>
              </tr>
            </tbody>
          </table>

          <!-- Fielding Table -->
          <h5>Fielding</h5>
          <table class="table table-bordered table-striped">
            <thead class="table-dark">
              <tr>
                <th>Catches</th>
                <th>Runouts</th>
                <th>Stumpings</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><%= fieldStats.catches %></td>
                <td><%= fieldStats.runouts %></td>
                <td><%= fieldStats.stumpings %></td>
              </tr>
            </tbody>
          </table>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
