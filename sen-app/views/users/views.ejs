<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>
    <%= user.username %>'s Profile
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/styles/users/profilePage.css" rel="stylesheet">
</head>

<body class="bg-light">
  <div class="container py-4">
    <a href="javascript:history.back()" class="btn btn-outline-secondary mb-3">
      &larr; Back
    </a>

    <!-- Profile Header -->
    <div class="d-flex align-items-center gap-3 mb-4">
      <img src="<%= user.profile_pic %>" alt="Profile Picture" class="profile-pic">
      <div class="username">
        <%= user.username %>
      </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs justify-content-center" id="profileTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="summer25-tab" data-bs-toggle="tab" data-bs-target="#summer25" type="button"
          role="tab">Summer Test 2025</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="winter24-tab" data-bs-toggle="tab" data-bs-target="#winter24" type="button"
          role="tab">Winter Test 2024</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="summer24-tab" data-bs-toggle="tab" data-bs-target="#summer24" type="button"
          role="tab">Summer Test 2024</button>
      </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="profileTabsContent">
      <% const tests=['summer25', 'winter24' , 'summer24' ]; %>
        <% tests.forEach(test=> { %>
          <div class="tab-pane fade <%= test === 'summer25' ? 'show active' : '' %>" id="<%= test %>" role="tabpanel">
            <!-- Batting Table -->
            <h5 class="mt-4">Batting</h5>
            <table class="table table-bordered table-striped">
              <thead class="table-dark">
                <tr>
                  <th>Runs Scored</th>
                  <th>Wickets Played</th>
                  <th>Batting Average</th>
                  <th>Average Strike Rate</th>
                  <th>4s Hit</th>
                  <th>50s</th>
                  <th>100s</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><%=batStats.runs%></td>
                  <td>1</td>
                  <td>39.00</td>
                  <td>85.3</td>
                  <td>8</td>
                  <td>1</td>
                  <td>0</td>
                </tr>
              </tbody>
            </table>

            <!-- Bowling Table -->
            <h5>Bowling</h5>
            <table class="table table-bordered table-striped">
              <thead class="table-dark">
                <tr>
                  <th>Wickets Taken</th>
                  <th>Overs Bowled</th>
                  <th>Maidens</th>
                  <th>Average Economy</th>
                  <th>Strike Rate</th>
                  <th>Bowling Average</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>3</td>
                  <td>10</td>
                  <td>1</td>
                  <td>3.7</td>
                  <td>20.0</td>
                  <td>18.3</td>
                </tr>
              </tbody>
            </table>

            <!-- Fielding Table -->
            <h5>Fielding</h5>
            <table class="table table-bordered table-striped">
              <thead class="table-dark">
                <tr>
                  <th>Catches</th>
                  <th>Runouts</th>
                  <th>Stumpings</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>2</td>
                  <td>1</td>
                  <td>0</td>
                </tr>
              </tbody>
            </table>
          </div>
          <% }) %>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>