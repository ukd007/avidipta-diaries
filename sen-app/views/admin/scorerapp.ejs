<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/styles/scorerapp.css">
<nav class="navbar bg-primary">
    <div class="container-fluid justify-content-center">
        <span class="navbar-brand mb-0 h1 text-white">Cricket Scorer</span>
    </div>
</nav>
  <div class="form-wrapper">
<h2>Enter Match Details</h2>
<form action="/start-match" method="post">
  <label for="team1">Team 1 Name:</label><br>
  <input type="text" id="team1" name="team1" oninput="updateTossOptions()" required><br><br>

  <label for="team2">Team 2 Name:</label><br>
  <input type="text" id="team2" name="team2" oninput="updateTossOptions()" required><br><br>

  <label for="tossWinner">Toss Won By:</label><br>
  <select id="tossWinner" name="tossWinner" onchange="showDecisionSection()" required>
    <option value="">-- Select a team --</option>
  </select><br><br>

  <div id="decisionSection" style="display: none;">
    <span id="tossWinnerName"></span> elected to:
    <br>
    <input type="radio" id="bat" name="tossDecision" value="Bat" required>
    <label for="bat">Bat</label><br>
    <input type="radio" id="bowl" name="tossDecision" value="Bowl" required>
    <label for="bowl">Bowl</label><br><br>
  </div>

  <button type="submit">Start Match</button>
</form>
</div>

<script>
  function updateTossOptions() {
    const team1 = document.getElementById("team1").value;
    const team2 = document.getElementById("team2").value;
    const tossSelect = document.getElementById("tossWinner");

    tossSelect.innerHTML = '<option value="">-- Select a team --</option>';

    if (team1) {
      tossSelect.add(new Option(team1, team1));
    }
    if (team2) {
      tossSelect.add(new Option(team2, team2));
    }

    document.getElementById("decisionSection").style.display = "none"; // hide on name change
  }

  function showDecisionSection() {
    const tossWinner = document.getElementById("tossWinner").value;
    const decisionSection = document.getElementById("decisionSection");
    const tossWinnerName = document.getElementById("tossWinnerName");

    if (tossWinner) {
      tossWinnerName.textContent = tossWinner;
      decisionSection.style.display = "block";
    } else {
      decisionSection.style.display = "none";
    }
  }
</script>
