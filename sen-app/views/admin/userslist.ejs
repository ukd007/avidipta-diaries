<div class="container py-4">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% users.forEach(user=> { %>
            <div class="col">
                <div class="user-card">
                    <div class="profile-pic-frame">
                        <img src="<%= user.profile_pic%>"
                            alt="Profile picture of <%= user.username %>" class="profile-pic" draggable="false" />
                    </div>
                    <h5>
                        <%= user.username %>
                    </h5>
                    <a href="/admin/users/<%= user.id %>/edit" class="btn btn-primary btn-sm mt-2">Edit</a>
                </div>
            </div>
            <% }); %>
    </div>
</div>
<script>
    window.addEventListener('DOMContentLoaded', () => {
        const imgs = document.querySelectorAll('.profile-pic');

        imgs.forEach(img => {
            const offsetX = parseFloat(img.dataset.offsetX) || 0;
            const offsetY = parseFloat(img.dataset.offsetY) || 0;

            // Combine centering (-50%, -50%) + user offset in px
            img.style.transform = `translate(calc(-50% + ${offsetX}px), calc(-50% + ${offsetY}px))`;
        });
    });


</script>