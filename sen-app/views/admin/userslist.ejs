<!-- Bootstrap Navbar with Back Button -->
<nav class="navbar navbar-light bg-light">
  <div class="container-fluid">
    <a href="/admin/dashboard" class="navbar-brand d-flex align-items-center">
      <span class="material-icons">arrow_back</span>
      <span class="ms-2">Back</span>
    </a>
  </div>
</nav>

<div class="container py-4">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% users.forEach(user=> { %>
            <div class="col">
                <div class="user-card">
                    <div class="profile-pic-frame">
                        <img src="<%= user.profile_pic%>"
                            alt="Profile picture of <%= user.username %>" class="profile-pic" draggable="false" />
                    </div>
                    <h5>
                        <%= user.username %>
                    </h5>
                    <a href="/admin/users/<%= user.id %>/edit" class="btn btn-primary btn-sm mt-2">Edit</a>
                </div>
            </div>
            <% }); %>
    </div>
</div>
