<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Edit Profile Picture - <%= user.username %></title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Cropper CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />

  <!-- Google Material Icons -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

  <!-- Custom CSS -->
  <link href="/styles/admin/usereditform.css" rel="stylesheet" />
</head>

<body>
  <main class="container mt-5">
    <!-- Optional back button -->
    <a href="/dashboard" class="btn btn-outline-secondary mb-4">
      <span class="material-icons">arrow_back</span> Back
    </a>

    <section aria-labelledby="profile-pic-heading" class="mb-5">
      <h2 id="profile-pic-heading" class="mb-3">Edit Profile Picture for <%= user.username %></h2>

      <form id="uploadForm" enctype="multipart/form-data" novalidate>
        <div class="mb-3">
          <label for="fileInput" class="form-label">Choose Image</label>
          <input type="file" name="image" id="fileInput" accept="image/*" class="form-control" required
            aria-describedby="fileHelp" />
          <div id="fileHelp" class="form-text">Select an image to crop before uploading.</div>
        </div>

        <div id="previewContainer" style="display:none;">
          <img id="previewImage" src="#" alt="Cropped Image Preview" style="max-width:100%;" />
        </div>

        <button type="submit" class="btn btn-primary mt-3" disabled id="uploadBtn">Crop & Upload</button>
      </form>
    </section>

    <section class="container-fluid mt-4">
      <div class="row">
        <!-- LEFT PANEL: Edit Stats Form -->
        <div class="col-md-8">
          <h3>Update Stats for <%= user.username %></h3>

          <form action="/update-player/<%= user.id %>?table=<%= table %>" method="POST">
            <div class="row">
              <% [ 'runs' , 'balls_played' , 'wickets_played' , 'fours' , 'fifties' , 'hundreds' , 'wickets_taken', 
                  'total_balls_bowled' , 'maidens' , 'runs_conceded' , 'catches' , 'runouts' , 'stumpings'
                ].forEach(field => { %>
                <div class="col-md-4 mb-3">
                  <label class="form-label"><%= field.replace(/_/g, ' ') %></label>
                  <input
                    type="number"
                    class="form-control"
                    name="<%= field %>"
                    value="<%= user[field] || 0 %>"
                    id="<%= field %>"
                    min="0"
                  />
                </div>
              <% }) %>
            </div>
            <button type="submit" class="btn btn-primary">✅ Update Stats</button>
          </form>
        </div>

        <!-- RIGHT PANEL: Sticky Notes -->
        <div class="col-md-4">
          <h4>📒 Notes / PDF Jot</h4>
          <textarea
            class="form-control"
            rows="30"
            style="resize: vertical; max-height: 600px;"
            placeholder="Write your calculations or notes here while reading the PDFs..."
          ></textarea>
        </div>
      </div>
    </section>
  </main>

  <!-- JS Libraries -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    let cropper;
    const fileInput = document.getElementById('fileInput');
    const previewImage = document.getElementById('previewImage');
    const previewContainer = document.getElementById('previewContainer');
    const uploadBtn = document.getElementById('uploadBtn');
    const uploadForm = document.getElementById('uploadForm');

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) {
        previewContainer.style.display = 'none';
        uploadBtn.disabled = true;
        if (cropper) {
          cropper.destroy();
          cropper = null;
        }
        previewImage.src = '#';
        return;
      }

      const reader = new FileReader();
      reader.onload = () => {
        previewImage.src = reader.result;
        previewContainer.style.display = 'block';

        if (cropper) {
          cropper.destroy();
        }

        cropper = new Cropper(previewImage, {
          aspectRatio: 1,
          viewMode: 1,
          dragMode: 'move',
          autoCropArea: 0.7,
          cropBoxResizable: false,
          cropBoxMovable: true,
          ready() {
            cropper.setCropBoxData({ width: 200, height: 200 });
          }
        });

        uploadBtn.disabled = false;
      };
      reader.readAsDataURL(file);
    });

    uploadForm.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!cropper) {
        alert('Please select and crop an image.');
        return;
      }

      cropper.getCroppedCanvas({
        width: 200,
        height: 200
      }).toBlob(blob => {
        const formData = new FormData();
        formData.append('croppedImage', blob);

        // Replace below with your actual upload logic:
        fetch('/upload-profile-pic', {
          method: 'POST',
          body: formData
        })
          .then(response => {
            if (!response.ok) throw new Error('Upload failed');
            return response.json();
          })
          .then(data => {
            alert('Image uploaded successfully!');
            // Optionally refresh page or update profile picture preview
          })
          .catch(error => {
            alert('Upload error: ' + error.message);
          });
      });
    });
  </script>
</body>

</html>
