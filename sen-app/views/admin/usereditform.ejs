<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>User Data Edit Form</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/styles/admin/usereditform.css" rel="stylesheet">
</head>

<body>
  <!-- Load Google Material Icons -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

  <!-- Bootstrap Navbar with Back Button -->
  <nav class="navbar navbar-light bg-light">
    <div class="container-fluid">
      <a href="/admin/users" class="navbar-brand d-flex align-items-center">
        <span class="material-icons">arrow_back</span>
        <span class="ms-2">Back</span>
      </a>
    </div>
  </nav>

  <!-- Profile Picture Crop Section -->
  <h2 class="mb-4">Edit Profile Picture for <%= user.username %>
  </h2>

  <form id="uploadForm" enctype="multipart/form-data">
    <input type="file" name="image" id="fileInput" accept="image/*" required />
    <div id="previewContainer">
      <img id="previewImage" src="#" alt="Preview" />
    </div>
    <button type="submit" class="btn">Crop & Upload</button>
  </form>

  <hr class="my-5">

  <!-- Cricket Stats Tabs -->
  <!-- Cricket Stats Tabs -->
  <h2 class="mb-4">Update Summer 2025 Stats for <%= user.username %>
  </h2>
  <% if (message) { %>
    <div class="alert alert-success">
      <%= message %>
    </div>
    <% } %>
      <% if (error) { %>
        <div class="alert alert-danger">
          <%= error %>
        </div>
        <% } %>


          <% if (req.session.error) { %>
            <div class="alert alert-danger">
              <%= req.session.error %>
            </div>
            <% } %>

              <ul class="nav nav-tabs" id="statsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" id="batting-tab" data-bs-toggle="tab" data-bs-target="#batting"
                    type="button" role="tab">Batting</button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="bowling-tab" data-bs-toggle="tab" data-bs-target="#bowling" type="button"
                    role="tab">Bowling</button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="fielding-tab" data-bs-toggle="tab" data-bs-target="#fielding"
                    type="button" role="tab">Fielding</button>
                </li>
              </ul>

              <div class="tab-content p-3 border border-top-0" id="statsTabsContent">

                <!-- Batting -->
                <div class="tab-pane fade show active" id="batting" role="tabpanel">
                  <form method="POST" action="/update-batting">
                    <div class="row g-2">
                      <div class="col"><input type="number" name="runs" class="form-control" placeholder="Runs"
                          required>
                      </div>
                      <div class="col"><input type="number" name="balls_played" class="form-control"
                          placeholder="Balls Played" required></div>
                      <div class="col"><input type="number" name="fours_hit" class="form-control"
                          placeholder="Fours Hit" required>
                      </div>
                      <div class="col"><input type="number" name="wickets_played" class="form-control"
                          placeholder="Wickets Played" required></div>
                      <div class="col"><input type="number" name="fifties" class="form-control" placeholder="50s"
                          required>
                      </div>
                      <div class="col"><input type="number" name="hundreds" class="form-control" placeholder="100s"
                          required></div>
                    </div>
                    <input type="hidden" name="player_id" value="<%= user.id %>">


                    <button type="submit" class="btn btn-primary mt-3">Submit Batting</button>
                  </form>
                </div>

                <!-- Bowling -->
                <div class="tab-pane fade" id="bowling" role="tabpanel">
                  <form method="POST" action="/update-bowling">

                    <div class="row g-2">
                      <div class="col"><input type="number" name="wickets_taken" class="form-control"
                          placeholder="Wickets Taken" required></div>
                      <div class="col"><input type="text" name="overs_bowled" class="form-control"
                          placeholder="Overs Bowled (e.g., '10.4')" required></div>
                      <div class="col"><input type="number" name="maidens" class="form-control" placeholder="Maidens"
                          required>
                      </div>
                      <div class="col"><input type="number" name="runs_conceded" class="form-control"
                          placeholder="Runs Conceded" required>
                      </div>
                    </div>
                    <input type="hidden" name="player_id" value="<%= user.id %>">

                    <button type="submit" class="btn btn-primary mt-3">Submit Bowling</button>
                  </form>
                </div>

                <!-- Fielding -->
                <div class="tab-pane fade" id="fielding" role="tabpanel">
                  <form method="POST" action="/update-fielding">

                    <div class="row g-2">
                      <div class="col"><input type="number" name="catches" class="form-control" placeholder="Catches"
                          required>
                      </div>
                      <div class="col"><input type="number" name="runouts" class="form-control" placeholder="Runouts"
                          required>
                      </div>
                      <div class="col"><input type="number" name="stumpings" class="form-control"
                          placeholder="Stumpings" required>
                      </div>
                    </div>
                    <input type="hidden" name="player_id" value="<%= user.id %>">
                    <button type="submit" class="btn btn-primary mt-3">Submit Fielding</button>
                  </form>
                </div>

              </div>


              <!-- JS Libraries -->
              <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
              <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

              <!-- JS Logic -->
              <script>
                let cropper;
                const fileInput = document.getElementById('fileInput');
                const previewImage = document.getElementById('previewImage');
                const uploadForm = document.getElementById('uploadForm');

                fileInput.addEventListener('change', (e) => {
                  const file = e.target.files[0];
                  if (!file) return;

                  const reader = new FileReader();
                  reader.onload = () => {
                    previewImage.src = reader.result;
                    previewImage.style.display = 'block';

                    if (cropper) {
                      cropper.destroy();
                    }

                    cropper = new Cropper(previewImage, {
                      aspectRatio: 1,
                      viewMode: 1,
                      dragMode: 'move',
                      autoCropArea: 0.7,
                      cropBoxResizable: false,
                      cropBoxMovable: true,
                      ready() {
                        cropper.setCropBoxData({ width: 200, height: 200 });
                      }
                    });
                  };
                  reader.readAsDataURL(file);
                });

                uploadForm.addEventListener('submit', function (e) {
                  e.preventDefault();
                  if (!cropper) return alert('Please select and crop an image');

                  cropper.getCroppedCanvas({
                    width: 200,
                    height: 200
                  }).toBlob(blob => {
                    const formData = new FormData();
                    formData.append('croppedImage', blob);

                    // Simulate upload without actual request
                    console.log('Simulating image upload...');
                    alert('Image would be uploaded here.');
                  });
                });
              </script>
</body>

</html>