// utils/summer25Stats.js
const db = require('../../config/db');

function getSummer25Stats(userId, callback) {
    const q2 = `SELECT * FROM batstats_summer25 WHERE id = ?`;
    const q3 = `SELECT * FROM bowlstats_summer25 WHERE id = ?`;
    const q4 = `SELECT * FROM fieldstats_summer25 WHERE id = ?`;

    const stats = {};

    db.query(q2, userId, (err, batStatsResults) => {
        if (err) return callback(err);
        if (batStatsResults.length === 0) return callback(null, null, "Batting Stats Not Found");
        stats.batStats = batStatsResults[0];

        db.query(q3, userId, (err, bowlStatsResults) => {
            if (err) return callback(err);
            stats.bowlStats = bowlStatsResults[0] || null;

            db.query(q4, userId, (err, fieldStatsResults) => {
                if (err) return callback(err);
                stats.fieldStats = fieldStatsResults[0] || null;

                return callback(null, stats, null);
            });
        });
    });
}

module.exports = getSummer25Stats;
